# LLM API Keys (Set at least one; keys stay secure on the backend server)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Speech-to-Text Whisper configuration
ENABLE_WHISPER=true
WHISPER_MODEL=tiny

# Edge-TTS Voice for Mode 2 Explainer Reels
TTS_VOICE=en-US-ChristopherNeural

# Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:5173
